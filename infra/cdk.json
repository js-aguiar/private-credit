{
  "app": "python app.py",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "requirements*.txt", "**/__pycache__"]
  },
  "context": {
    "prefix": "br-sec-scrapers",
    "alert_email": "",
    "schedules_enabled": true,
    "schedule_stagger_minutes": 5,
    "backfill_instance_type": "t4g.small",
    "backfill_max_hours": 24,
    "backfill_request_delay_seconds": "2",
    "backfill_request_jitter_seconds": "1",
    "backfill_max_requests_per_minute": "20",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:target-partitions": ["aws"]
  }
}
